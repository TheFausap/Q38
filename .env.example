# llama-server origin (OpenAI-compatible API)
LLAMA_SERVER_URL=http://127.0.0.1:8080

# Optional bearer token if you started llama-server with --api-key
LLAMA_API_KEY=

# Folder shown in the workbench file tree (read-only context injection)
WORKSPACE_DIR=./workspace

# Web search for the model's tools. No key at all is needed for DuckDuckGo, but a
# SearXNG instance or an API key is steadier. These can also be set in Setup, which
# sends them per request and wins over the environment.
Q38_SEARCH_PROVIDER=auto
Q38_SEARCH_KEY=
Q38_SEARX_URL=
# Let the model read pages on this machine or this network (off by default: it is
# how a local page could turn into a probe of your own services)
Q38_WEB_ALLOW_PRIVATE=

# Skills the model can consult (procedure manuals in the Agent Skills layout).
# Fill the folder with `npm run skills:sync`.
Q38_SKILLS_DIR=./skills

# The library: where documents are kept (default <state>/library), and an optional
# OpenAI-compatible embeddings server (llama-server --embedding) for search by meaning.
Q38_LIBRARY_DIR=
Q38_EMBED_URL=
