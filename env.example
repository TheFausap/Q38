# llama-server origin (OpenAI-compatible API)
LLAMA_SERVER_URL=http://127.0.0.1:8080

# Optional bearer token if you started llama-server with --api-key
LLAMA_API_KEY=

# Folder shown in the workbench file tree (read-only context injection)
WORKSPACE_DIR=./workspace

# Web search for the model's tools. No key at all is needed for DuckDuckGo, but a
# SearXNG instance or an API key is steadier. These can also be set in Setup, which
# sends them per request and wins over the environment.
Q38_SEARCH_PROVIDER=auto
Q38_SEARCH_KEY=
Q38_SEARX_URL=
# Let the model read pages on this machine or this network (off by default: it is
# how a local page could turn into a probe of your own services)
Q38_WEB_ALLOW_PRIVATE=

# Skills the model can consult (procedure manuals in the Agent Skills layout).
# Fill the folder with `npm run skills:sync`.
Q38_SKILLS_DIR=./skills

# The library: where documents are kept (default <state>/library), and an optional
# OpenAI-compatible embeddings server (llama-server --embedding) for search by meaning.
Q38_LIBRARY_DIR=
Q38_EMBED_URL=
# An OpenAI-compatible vision endpoint serving an OCR model (OvisOCR2 or PaddleOCR-VL on vLLM):
# scans are read with it, and any PDF can be re-read with it for faithful maths.
Q38_OCR_URL=
# How to ask it: auto (from the served model's name), ovisocr2, paddleocr-vl or custom.
# Custom takes Q38_OCR_PROMPT, Q38_OCR_MAX_TOKENS and Q38_OCR_PIXELS.
Q38_OCR_PROFILE=auto
# Bearer tokens, if the embeddings or OCR server was started with an API key
Q38_EMBED_API_KEY=
Q38_OCR_API_KEY=

# --- Docker (compose.yaml) ---------------------------------------------------
# compose.yaml reads this file as .env too. Inside the container it fixes the paths
# itself (/workspace, /skills, /data), so WORKSPACE_DIR, Q38_SKILLS_DIR and
# Q38_LIBRARY_DIR above are ignored there.
# Port the container listens on (with host networking, the host's port)
Q38_PORT=4173
# GitHub token for the gh inside the container, instead of mounting ~/.config/gh
GH_TOKEN=
